# Редактор Godot — не часть проекта, десятки-сотни МБ, отдельно скачивается.
Godot_v4.7-stable_win64.exe

# Служебный кэш импорта Godot — пересоздаётся автоматически при открытии проекта.
.godot/

# Сырые скачанные исходники (geojson/tif и т.п., см. scripts/tools/_work) —
# десятки-сотни МБ, не редактируются руками, легко перекачать заново по
# инструкциям в докстрингах scripts/tools/build_*.py.
scripts/tools/_work/

# Запечённые тайлы и сгенерированные растры — легко пересчитываются из
# assets/*.json + scripts/tools/bake_*.py/build_*.py, не редактируются
# руками, занимают сотни МБ.
assets/tiles_bundle/
assets/generated/

# Кэш байткода Python — пересоздаётся автоматически.
__pycache__/

# Черновая папка bake-запекания нового слоя 2 (ocean_v_final) — многодневный
# прогон, десятки тысяч PNG, легко перезапустить из assets/config/
# ocean_v_bake_profile.json + scripts/tools/bake_ocean_v_*.py. Не смешивать
# со старым результатом assets/tiles_bundle/world_ocean_baked (см. задачу
# "заменить слой 2 запечённой версией слоя V", 2026-07-13).
build_artifacts/ocean_v_final/
